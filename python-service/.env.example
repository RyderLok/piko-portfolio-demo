# Public clone default. Set DEMO_MODE=false only on a private machine with real secrets.
DEMO_MODE=true

# Production LLM (ignored while DEMO_MODE=true). Placeholders only.
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_OMNI_ENABLED=0
SILICONFLOW_OMNI_MODEL=Qwen/Qwen3-Omni-30B-A3B-Instruct
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

PUBLIC_BASE_URL=
HOST=0.0.0.0
PORT=8001

# Production storage (server-side only). Leave empty for local demo files.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_SOUNDS_BUCKET=sounds
